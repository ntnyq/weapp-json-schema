{
  "name": "weapp-json-schema",
  "type": "module",
  "version": "0.5.1",
  "packageManager": "pnpm@11.6.0",
  "description": "JSON schema for weapp",
  "keywords": [
    "json-schema",
    "jsonschema",
    "miniprogram",
    "weapp",
    "wechat"
  ],
  "license": "MIT",
  "author": {
    "name": "ntnyq",
    "email": "ntnyq13@gmail.com"
  },
  "homepage": "https://github.com/ntnyq/weapp-json-schema#readme",
  "repository": "ntnyq/weapp-json-schema",
  "bugs": {
    "url": "https://github.com/ntnyq/weapp-json-schema/issues"
  },
  "exports": {
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "*.schema.json"
  ],
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "eslint",
    "prepare": "husky",
    "release": "run-s release:check release:version",
    "release:check": "run-p format:check lint test",
    "release:version": "bumpp",
    "test": "vitest"
  },
  "devDependencies": {
    "@ntnyq/eslint-config": "^6.1.5",
    "@types/node": "^25.9.3",
    "ajv": "^8.20.0",
    "bumpp": "^11.1.0",
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "npm-run-all2": "^9.0.1",
    "oxfmt": "^0.54.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "nano-staged": {
    "*.{js,ts,cjs,mjs,md,yml,yaml,json}": "eslint --fix"
  }
}
